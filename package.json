{
  "name": "solar-member-system",
  "version": "1.0.0",
  "private": true,
  "description": "太阳线会员系统 · monorepo 根",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @solar/api prisma:generate",
    "db:push": "pnpm --filter @solar/api prisma:push",
    "db:migrate": "pnpm --filter @solar/api db:migrate",
    "db:status": "pnpm --filter @solar/api db:status",
    "db:seed": "pnpm --filter @solar/api prisma:seed",
    "dev:api": "pnpm --filter @solar/api dev",
    "dev:admin": "pnpm --filter @solar/admin dev",
    "dev:member": "pnpm --filter @solar/member dev:h5",
    "dev:partner": "pnpm --filter @solar/partner dev:h5",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "smoke": "pnpm --filter @solar/api test:smoke",
    "e2e": "pnpm --filter @solar/api test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
