// 太阳线会员系统 · 数据模型
// 口径来源：docs/太阳线会员系统-完整架构文档.md
// 金额统一以「元」为单位的整数存储在 BIGINT 中。
// 系统不接外部提现渠道；权益通按档位发放，仅约束会员间钱包转出。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户与关系
// ============================================================

model User {
  id                   BigInt    @id @default(autoincrement())
  unionid              String?   @unique @db.VarChar(64)
  phone                String?   @unique @db.VarChar(20)
  nickname             String?   @db.VarChar(64)
  avatar               String?   @db.VarChar(512)
  passwordHash         String?   @db.VarChar(255)
  transferPasswordHash String?   @db.VarChar(255)
  inviteCode           String    @unique @db.VarChar(32)

  packageId            Int?
  packageExpireAt      DateTime?
  rankId               Int       @default(0)
  rankLevel            Int       @default(0)
  rankAchievedAt       DateTime?

  /// 团队历史累计业绩（每日累加，只增不减）
  totalTeamPerformance BigInt    @default(0)

  /// 关系树：parent_id / path / depth
  parentId             BigInt?
  /// 祖先路径，格式 ,1,5,23,（前后均有逗号），伞下查询用 path LIKE '%,id,%'
  /// 用 Text 而非定长：深度可达 MAX_TREE_DEPTH（1000），定长字段会在数百层后写入失败
  path                 String    @default(",")
  depth                Int       @default(0)

  /// 0 尚有权益通 1 权益通已用完；不影响收益结算
  transferQuotaStatus  Int       @default(0) @db.SmallInt
  /// 平级奖历史锁定：首次满足「上级等级 <= 下级等级」即永久置位
  peerBonusLocked      Boolean   @default(false)
  peerBonusLockedAt    DateTime?

  realNameStatus       Int       @default(0) @db.SmallInt
  realName             String?   @db.VarChar(256)
  idCardEncrypted      String?   @db.VarChar(512)

  /// 0 正常 1 冻结 2 注销
  status               Int       @default(0) @db.SmallInt
  /// 修改登录凭据后递增，撤销已有登录会话
  authVersion          Int       @default(0)
  /// SUPER_ADMIN / OPERATOR / FINANCE / SUPPORT / MEMBER
  role                 String    @default("MEMBER") @db.VarChar(32)
  /// 账号级页面权限；未自定义时按角色默认权限执行
  adminPermissionsCustomized Boolean @default(false)
  adminPermissionCodes        String[] @default([])
  deviceFingerprint    String?   @db.VarChar(128)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  parent               User?               @relation("UserTree", fields: [parentId], references: [id])
  children             User[]              @relation("UserTree")
  package              Package?            @relation(fields: [packageId], references: [id])
  rank                 Rank                @relation(fields: [rankId], references: [id])
  addresses            UserAddress[]
  auths                UserAuth[]
  orders               Order[]             @relation("OrderUser")
  orderPerformance     OrderPerformance[]
  equityAccount        EquityAccount?
  equityLots           EquityLot[]
  equityTransactions   EquityTransaction[]
  equityTransfersFrom  EquityTransfer[]    @relation("EquityTransferFrom")
  equityTransfersTo    EquityTransfer[]    @relation("EquityTransferTo")
  bonusPlans           BonusPlan[]         @relation("BonusPlanBeneficiary")
  bonusRecords         BonusRecord[]       @relation("BonusRecordUser")
  bonusRecordSources   BonusRecord[]       @relation("BonusRecordSourceUser")
  teamPerformances     TeamPerformance[]
  rankLogs             RankLog[]
  dividends            Dividend[]
  wallet               Wallet?
  walletTransactions   WalletTransaction[]
  walletTransfersFrom  WalletTransfer[]    @relation("WalletTransferFrom")
  walletTransfersTo    WalletTransfer[]    @relation("WalletTransferTo")
  tokenAccount         TokenAccount?
  tokenLots            TokenLot[]
  tokenTransactions    TokenTransaction[]
  tokenTransfersFrom   TokenTransfer[]     @relation("TokenTransferFrom")
  tokenTransfersTo     TokenTransfer[]     @relation("TokenTransferTo")
  transferQuotaAccount TransferQuotaAccount?
  transferQuotaTransactions TransferQuotaTransaction[]
  riskEvents           RiskEvent[]

  @@index([parentId])
  // path 为深层物化路径（最长 MAX_TREE_DEPTH × 约 12B ≈ 12KB）。
  // PG btree 索引单行上限约 2704B，深层 path 会导致写入直接失败，故不设 path 索引：
  // 伞下查询用 LIKE '%,id,%'（contains）本就全表扫描，startsWith 亦为低频管理操作。
  @@index([depth])
  @@index([rankId])
  @@index([transferQuotaStatus])
  @@index([createdAt])
}

model UserAddress {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  receiver    String   @db.VarChar(64)
  phone       String   @db.VarChar(20)
  province    String   @db.VarChar(64)
  city        String   @db.VarChar(64)
  district    String   @db.VarChar(64)
  detail      String   @db.VarChar(512)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAuth {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  /// PHONE / WECHAT / ALIPAY
  provider    String   @db.VarChar(32)
  identifier  String   @db.VarChar(128)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, identifier])
  @@index([userId])
}

// ============================================================
// 档位与订单
// ============================================================

model Package {
  id           Int      @id
  name         String   @db.VarChar(64)
  level        Int      @unique
  price        BigInt
  /// 档位PV；奖金与业绩基数按 1 PV = 1 元计算
  pv           BigInt   @default(0)
  /// 标准权益通值，按档位PV × 3派生；账户发放额以支付成功时的PV快照计算
  transferQuota BigInt
  durationDays Int      @default(365)
  /// 为空时继承全局 bonus.reward_rate；以比例存储，如 1.0 = 100%
  directRewardRate     Decimal? @db.Decimal(5, 4)
  /// 为空时继承全局 bonus.repurchase_rate
  repurchaseRewardRate Decimal? @db.Decimal(5, 4)
  /// 为空时继承全局 bonus.direct_periods
  directReleaseDays    Int?
  items        Json     @default("[]")
  /// 0 停用 1 启用
  status       Int      @default(1) @db.SmallInt
  sort         Int      @default(0)
  createdAt    DateTime @default(now())

  users        User[]
  orders       Order[]
  productBinds ProductPackage[]
}

/// 商品分类：支持父子两级，parentId=null 为一级分类
model ProductCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(64)
  parentId    BigInt?
  icon        String?  @db.VarChar(255)
  sort        Int      @default(0)
  /// 0 停用 1 启用
  status      Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
}

model Product {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(128)
  subtitle     String?  @db.VarChar(255)
  description  String?  @db.Text
  categoryId   BigInt?
  /// 主图 + 轮播图 URL 数组，来自 FileAsset
  images       Json     @default("[]")
  /// 详情图 URL 数组
  details      Json     @default("[]")
  price        BigInt
  /// 商品PV，按件计入业绩
  pv           BigInt   @default(0)
  /// 划线价
  originalPrice BigInt  @default(0)
  stock        Int      @default(0)
  sales        Int      @default(0)
  /// 0 下架 1 上架
  status       Int      @default(0) @db.SmallInt
  /// 是否新品 / 推荐
  isNew        Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  packageBinds ProductPackage[]

  @@index([categoryId, status])
  @@index([status, sort])
}

/// 商品与会员档绑定：某商品可被哪些会员档购买/可见
model ProductPackage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt
  packageId Int
  /// 该档位专属价，null 表示用商品默认价
  exclusivePrice BigInt?
  sort      Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([productId, packageId])
  @@index([packageId])
}

/// 文件管理：商品图片、头像、附件统一存储
model FileAsset {
  id           BigInt   @id @default(autoincrement())
  /// 存储文件名（磁盘上）
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(128)
  size         Int
  /// 相对 URL，如 /uploads/2026/11/xxx.png
  url          String   @unique @db.VarChar(512)
  /// PRODUCT / CATEGORY / AVATAR / OTHER
  category     String   @default("OTHER") @db.VarChar(32)
  /// 关联的业务 ID
  refId        String?  @db.VarChar(64)
  uploadedBy   BigInt?
  createdAt    DateTime @default(now())

  @@index([category, createdAt(sort: Desc)])
}

model Order {
  id               BigInt    @id @default(autoincrement())
  orderNo          String    @unique @db.VarChar(32)
  userId           BigInt
  /// 1 新购 2 升级 3 复消 4 普通商品
  type             Int       @db.SmallInt
  isRepurchase     Boolean   @default(false)
  packageId        Int?
  fromPackageId    Int?
  amount           BigInt
  /// 下单时锁定的计酬PV总量；历史订单迁移时沿用原订单金额
  pvAmount         BigInt   @default(0)
  equityDeduct     BigInt    @default(0)
  balanceDeduct    BigInt    @default(0)
  cashPay          BigInt    @default(0)
  /// 下单时的收货地址快照，地址簿变更不影响历史订单
  shippingAddress  Json?
  shippingCarrier  String?   @db.VarChar(64)
  trackingNo       String?   @db.VarChar(128)
  /// 0 CREATED 1 PAID 2 DELIVERED 3 COMPLETED
  status           Int       @default(0) @db.SmallInt
  /// 下单时推荐人快照
  parentIdSnapshot BigInt?
  remark           String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())
  paidAt           DateTime?
  /// 支付成功时完成业绩、权益通与直推计划登记；与后续交付状态独立
  businessEffectsAppliedAt DateTime?
  deliveredAt      DateTime?
  finishedAt       DateTime?

  user             User              @relation("OrderUser", fields: [userId], references: [id])
  package          Package?          @relation(fields: [packageId], references: [id])
  items            OrderItem[]
  performance      OrderPerformance?
  bonusPlan        BonusPlan?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([finishedAt])
}

model OrderItem {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt
  productId BigInt?
  name      String   @db.VarChar(128)
  price     BigInt
  /// 下单时锁定的单件PV
  pv        BigInt   @default(0)
  quantity  Int      @default(1)
  amount    BigInt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderPerformance {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @unique
  userId    BigInt
  /// 计酬基数：新订单读取 orders.pvAmount；切换前的历史记录保持原金额数值
  amount    BigInt
  occurDate DateTime @db.Date
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([occurDate])
}

// ============================================================
// 权益值账户与批次
// ============================================================

model EquityAccount {
  userId            BigInt   @id
  balance           BigInt   @default(0)
  totalGranted      BigInt   @default(0)
  totalUsed         BigInt   @default(0)
  totalExpired      BigInt   @default(0)
  totalTransferIn   BigInt   @default(0)
  totalTransferOut  BigInt   @default(0)
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id])
}

model EquityLot {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  amount      BigInt
  remaining   BigInt
  expireAt    DateTime
  /// ACTIVE / EXPIRED / FROZEN
  status      String   @default("ACTIVE") @db.VarChar(16)
  /// GRANT / TRANSFER_IN / UPGRADE
  sourceType  String   @db.VarChar(32)
  sourceId    String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  user        User                @relation(fields: [userId], references: [id])
  transactions EquityTransaction[]
  transferTo  EquityTransfer[]    @relation("EquityTransferToLot")

  @@index([userId, expireAt])
  @@index([status, remaining])
}

model EquityTransaction {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  /// 1 发放 2 消费 3 过期 4 转出 5 转入 6 调整
  type         Int      @db.SmallInt
  changeAmount BigInt
  balanceAfter BigInt
  lotId        BigInt?
  bizType      String   @db.VarChar(64)
  bizId        String   @db.VarChar(64)
  createdAt    DateTime @default(now())

  user         User      @relation(fields: [userId], references: [id])
  lot          EquityLot? @relation(fields: [lotId], references: [id])

  @@unique([bizType, bizId, lotId])
  @@index([userId, createdAt])
}

model EquityTransfer {
  id          BigInt   @id @default(autoincrement())
  transferNo  String   @unique @db.VarChar(64)
  fromUserId  BigInt
  toUserId    BigInt
  amount      BigInt
  fromLotIds  Json
  toLotId     BigInt?
  /// PENDING / COMPLETED / REJECTED / EXPIRED
  status      String   @default("PENDING") @db.VarChar(16)
  /// 0 正常 1 待审
  riskFlag    Int      @default(0) @db.SmallInt
  remark      String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  completedAt DateTime?

  fromUser    User      @relation("EquityTransferFrom", fields: [fromUserId], references: [id])
  toUser      User      @relation("EquityTransferTo", fields: [toUserId], references: [id])
  toLot       EquityLot? @relation("EquityTransferToLot", fields: [toLotId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

// ============================================================
// 奖金
// ============================================================

model TransferQuotaAccount {
  userId    BigInt   @id
  granted   BigInt   @default(0)
  adjustedOut BigInt @default(0)
  used      BigInt   @default(0)
  reserved  BigInt   @default(0)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model TransferQuotaTransaction {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  /// 1 档位发放 2 转账预占 3 拒绝/超时返还 4 钱包转出确认 5 人工调整 6 历史规则商城钱包消费（已停用）
  type         Int      @db.SmallInt
  changeAmount BigInt
  balanceAfter BigInt
  bizType      String   @db.VarChar(64)
  bizId        String   @db.VarChar(64)
  remark       String?  @db.VarChar(256)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@unique([bizType, bizId])
  @@index([userId, createdAt])
}

model BonusPlan {
  id              BigInt   @id @default(autoincrement())
  orderId         BigInt   @unique
  beneficiaryId   BigInt
  totalAmount     BigInt
  dailyAmount     BigInt
  periods         Int      @default(20)
  releasedAmount  BigInt   @default(0)
  /// PENDING / RELEASING / COMPLETED / CANCELLED
  status          String   @default("PENDING") @db.VarChar(16)
  startAt         DateTime
  createdAt       DateTime @default(now())

  order           Order         @relation(fields: [orderId], references: [id])
  beneficiary     User          @relation("BonusPlanBeneficiary", fields: [beneficiaryId], references: [id])
  stages          BonusStage[]
  records         BonusRecord[]

  @@index([status, startAt])
}

model BonusStage {
  id          BigInt   @id @default(autoincrement())
  planId      BigInt
  periodNo    Int
  amount      BigInt
  dueAt       DateTime
  releasedAt  DateTime?
  /// PENDING / RELEASED / CANCELLED
  status      String   @default("PENDING") @db.VarChar(16)

  plan        BonusPlan     @relation(fields: [planId], references: [id])
  records     BonusRecord[]

  @@unique([planId, periodNo])
  @@index([status, dueAt])
}

model BonusRecord {
  id                  BigInt   @id @default(autoincrement())
  userId              BigInt
  /// 1 直推 2 团队 3 平级 4 领导 5 分红
  type                Int      @db.SmallInt
  amount              BigInt
  cashAmount          BigInt
  tokenAmount         BigInt
  sourceUserId        BigInt?
  sourceOrderId       BigInt?
  planId              BigInt?
  stageId             BigInt?
  settleDate          DateTime @db.Date
  walletTransactionId BigInt?
  createdAt           DateTime @default(now())

  user                User        @relation("BonusRecordUser", fields: [userId], references: [id])
  sourceUser          User?       @relation("BonusRecordSourceUser", fields: [sourceUserId], references: [id])
  plan                BonusPlan?  @relation(fields: [planId], references: [id])
  stage               BonusStage? @relation(fields: [stageId], references: [id])
  tokenLots           TokenLot[]

  @@index([userId, settleDate])
  @@index([type, settleDate])
}

model TeamPerformance {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  statDate    DateTime @db.Date
  ownAmount   BigInt   @default(0)
  teamAmount  BigInt   @default(0)
  /// 当日结算时等级快照
  rankLevel   Int      @default(0)
  /// Step4 等级判定幂等标记，供断点续跑使用
  rankJudged  Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, statDate])
  @@index([statDate])
}

// ============================================================
// 等级与分红池
// ============================================================

model Rank {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(64)
  level       Int      @unique
  /// 团队累计业绩门槛（PV；1 PV = 1 元奖金基数）
  threshold   BigInt
  /// 手工晋升到此等级时新增的权益通额度（元）
  transferQuotaGrant BigInt @default(0)
  /// 团队奖费率
  teamRate    Decimal  @db.Decimal(5, 4)
  /// 分红池比例
  poolRate    Decimal  @db.Decimal(5, 4)
  sort        Int      @default(0)
  /// 0 停用 1 启用；停用后不再自动晋升，现有持有人保留既有结算规则
  status      Int      @default(1) @db.SmallInt

  users       User[]
  snapshots   RankSnapshot[]
  dividends   Dividend[]
}

model RankLog {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt
  fromLevel         Int
  toLevel           Int
  totalPerformance  BigInt
  /// AUTO / MANUAL
  triggerType       String   @db.VarChar(16)
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model RankSnapshot {
  id               BigInt   @id @default(autoincrement())
  statDate         DateTime @db.Date
  rankId           Int
  userCount        Int      @default(0)
  totalPerformance BigInt   @default(0)
  poolAmount       BigInt   @default(0)
  perCapita        BigInt   @default(0)

  rank             Rank       @relation(fields: [rankId], references: [id])
  dividends        Dividend[]

  @@unique([statDate, rankId])
}

model Dividend {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  statDate    DateTime @db.Date
  rankId      Int
  amount      BigInt
  snapshotId  BigInt?
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  rank        Rank         @relation(fields: [rankId], references: [id])
  snapshot    RankSnapshot? @relation(fields: [snapshotId], references: [id])

  @@unique([statDate, userId])
  @@index([rankId, statDate])
}

// ============================================================
// 钱包与太阳值
// ============================================================

model Wallet {
  userId           BigInt   @id
  balance          BigInt   @default(0)
  /// 转账待确认锁定额
  frozen           BigInt   @default(0)
  totalIn          BigInt   @default(0)
  totalOut         BigInt   @default(0)
  totalTransferIn  BigInt   @default(0)
  totalTransferOut BigInt   @default(0)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
}

model WalletTransaction {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  /// 1 奖金 2 消费 3 转出 4 转入 5 调整 6 转账退回
  type         Int      @db.SmallInt
  changeAmount BigInt
  balanceAfter BigInt
  bizType      String   @db.VarChar(64)
  bizId        String   @db.VarChar(64)
  remark       String?  @db.VarChar(256)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@unique([bizType, bizId])
  @@index([userId, createdAt])
}

model WalletTransfer {
  id          BigInt   @id @default(autoincrement())
  transferNo  String   @unique @db.VarChar(64)
  fromUserId  BigInt
  toUserId    BigInt
  amount      BigInt
  /// PENDING / COMPLETED / REJECTED / EXPIRED
  status      String   @default("PENDING") @db.VarChar(16)
  /// 0 正常 1 待审
  riskFlag    Int      @default(0) @db.SmallInt
  remark      String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  completedAt DateTime?

  fromUser    User     @relation("WalletTransferFrom", fields: [fromUserId], references: [id])
  toUser      User     @relation("WalletTransferTo", fields: [toUserId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

model TokenAccount {
  userId           BigInt   @id
  balance          BigInt   @default(0)
  totalGranted     BigInt   @default(0)
  totalTransferIn  BigInt   @default(0)
  totalTransferOut BigInt   @default(0)
  version          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TokenTransaction {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  /// 1 入账 2 出账
  type         Int      @db.SmallInt
  changeAmount BigInt
  balanceAfter BigInt
  bizType      String   @db.VarChar(64)
  bizId        String   @db.VarChar(64)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([bizType, bizId])
  @@index([userId, createdAt])
}

model TokenLot {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt
  amount        BigInt
  sourceBonusId BigInt?
  /// BONUS 奖励发放 / TRANSFER_IN 转入
  sourceType    String   @default("BONUS") @db.VarChar(16)
  sourceId      String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  sourceBonus   BonusRecord? @relation(fields: [sourceBonusId], references: [id])

  @@index([userId])
  @@index([userId, sourceType])
}

model TokenTransfer {
  id          BigInt   @id @default(autoincrement())
  transferNo  String   @unique @db.VarChar(64)
  fromUserId  BigInt
  toUserId    BigInt
  amount      BigInt
  /// 即时到账：创建即 COMPLETED
  status      String   @default("COMPLETED") @db.VarChar(16)
  /// 0 正常 1 待审
  riskFlag    Int      @default(0) @db.SmallInt
  remark      String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  completedAt DateTime?

  fromUser User @relation("TokenTransferFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("TokenTransferTo", fields: [toUserId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

// ============================================================
// 治理
// ============================================================

model Config {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(128)
  value       Json
  group       String   @db.VarChar(64)
  description String?  @db.VarChar(256)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique @db.VarChar(64)
  name          String   @db.VarChar(128)
  module        String   @db.VarChar(64)
  /// 全局开关：关闭后所有端隐藏，后端接口拒绝
  enabled       Boolean  @default(true)
  /// 分端开关：空数组表示全端开放
  platforms     Json     @default("[]")
  /// 分级开关：最低可见等级
  minRankLevel  Int      @default(0)
  config        Json     @default("{}")
  updatedBy     BigInt?
  updatedAt     DateTime @updatedAt

  @@index([module])
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  operatorType  String   @db.VarChar(32)
  operatorId    BigInt?
  action        String   @db.VarChar(128)
  targetType    String?  @db.VarChar(64)
  targetId      BigInt?
  before        Json?
  after         Json?
  remark        String?  @db.VarChar(512)
  ip            String?  @db.VarChar(64)
  ua            String?  @db.VarChar(512)
  createdAt     DateTime @default(now())

  @@index([action, createdAt])
  @@index([operatorId, createdAt])
}

model IdempotencyKey {
  id         BigInt   @id @default(autoincrement())
  key        String   @unique @db.VarChar(128)
  scene      String   @db.VarChar(64)
  result     Json?
  expireAt   DateTime
  createdAt  DateTime @default(now())

  @@index([expireAt])
}

model RiskEvent {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  eventType   String   @db.VarChar(64)
  score       Int      @default(0)
  detail      Json     @default("{}")
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([eventType, handled])
}

// ============================================================
// 日结批次（断点续跑）
// ============================================================

model SettleBatch {
  id          BigInt   @id @default(autoincrement())
  statDate    DateTime @unique @db.Date
  /// 已完成步数 0-11
  step        Int      @default(0)
  /// RUNNING / DONE / FAILED
  status      String   @default("RUNNING") @db.VarChar(16)
  error       String?  @db.Text
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

// ============================================================
// 双人复核审批流
// ============================================================

/// 等级调整 / 奖金调整 / 日结重跑 / 关系换绑 均需运营申请 + 财务复核
model Approval {
  id            BigInt   @id @default(autoincrement())
  /// RANK_ADJUST / BONUS_ADJUST / SETTLEMENT_RERUN / REBIND
  type          String   @db.VarChar(32)
  applicantId   BigInt
  applicantRole String   @db.VarChar(32)
  /// 业务参数快照，复核通过后按此执行
  payload       Json
  /// PENDING / APPROVED / REJECTED
  status        String   @default("PENDING") @db.VarChar(16)
  reviewerId    BigInt?
  reviewedAt    DateTime?
  remark        String?  @db.VarChar(512)
  /// 复核通过后的执行结果
  result        Json?
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([type, status])
}
